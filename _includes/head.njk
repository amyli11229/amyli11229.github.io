<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<script>document.documentElement.classList.add("js");try{if(localStorage.getItem("theme")==="dark")document.documentElement.setAttribute("data-theme","dark");}catch(e){}</script>
{% set path = page.url or "/" %}
{% if path == "/index.html" %}{% set path = "/" %}{% endif %}
<title>{% if pageTitle %}{{ pageTitle }}{% elif title %}{{ title }} — {{ site.name }}{% else %}{{ site.title }}{% endif %}</title>
<meta name="description" content="{{ description or lead or site.description }}">
<link rel="canonical" href="{{ site.url }}{{ path }}">
<meta property="og:type" content="website">
<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:title" content="{% if pageTitle %}{{ pageTitle }}{% elif title %}{{ title }} — {{ site.name }}{% else %}{{ site.title }}{% endif %}">
<meta property="og:description" content="{{ description or lead or site.description }}">
<meta property="og:url" content="{{ site.url }}{{ path }}">
<meta property="og:image" content="{{ site.url }}/{{ site.og_image }}">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{% if pageTitle %}{{ pageTitle }}{% elif title %}{{ title }} — {{ site.name }}{% else %}{{ site.title }}{% endif %}">
<meta name="twitter:description" content="{{ description or lead or site.description }}">
<meta name="twitter:image" content="{{ site.url }}/{{ site.og_image }}">
<meta name="theme-color" content="#f7f6f2">
<link rel="icon" href="{{ assetRoot }}favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="{{ assetRoot }}style.css">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:ital,wght@0,400;0,500;1,400&family=Spectral:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet">
