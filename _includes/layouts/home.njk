---
layout: layouts/base.njk
---
<main id="main" class="home-page">
    <section class="home-hero" aria-labelledby="hero-heading">
        <div class="home-hero-inner">
            <div class="home-hero-copy">
                <p class="home-hero-kicker bio-reveal">{{ hero_kicker }}</p>
                <h1 id="hero-heading" class="home-hero-title bio-reveal">{{ hero_title }}</h1>
                <p class="home-hero-support bio-reveal">{{ hero_support }}</p>
            </div>
            {% set sidebarClass = "home-hero-sidebar" %}
            {% set portraitClass = "about-hero-portrait" %}
            {% set showGithubGraph = true %}
            {% include "contact-sidebar.njk" %}
        </div>
        <a href="#work" class="scroll-hint bio-reveal" aria-label="Scroll to selected work">
            <span class="scroll-hint-label">{{ hero_scroll or "↓ Scroll to explore" }}</span>
        </a>
    </section>

    <section id="work" class="selected-work" aria-labelledby="work-heading">
        <header class="section-header scroll-reveal">
            <p class="section-kicker">Portfolio</p>
            <h2 id="work-heading" class="section-title">Selected work</h2>
        </header>
        <div class="featured-list">
            {% from "featured-project.njk" import render as renderFeatured %}
            {% for project in collections.projects | featured(true) %}
            {{ renderFeatured(project, loop.index, assetRoot) }}
            {% endfor %}
        </div>
    </section>

    <section id="more-work" class="experiments" aria-labelledby="experiments-heading">
        <header class="section-header scroll-reveal">
            <p class="section-kicker">More work</p>
            <h2 id="experiments-heading" class="section-title">Experiments &amp; studies</h2>
        </header>
        <div class="experiments-grid">
            {% from "experiment-item.njk" import render as renderExperiment %}
            {% for project in collections.projects | featured(false) %}
            {{ renderExperiment(project, assetRoot) }}
            {% endfor %}
        </div>
        <p class="home-about-link experiments-archive scroll-reveal">
            <a href="{{ assetRoot }}projects.html">View the full list <span aria-hidden="true">→</span></a>
        </p>
    </section>

    <section class="home-about" aria-labelledby="home-about-heading">
        {% set bio = collections.bioContent[0] %}
        <p class="section-kicker scroll-reveal">About</p>
        <h2 id="home-about-heading" class="home-about-title scroll-reveal">{{ bio.data.lead | inlineMarkdown | safe }}</h2>
        <p class="home-about-text scroll-reveal">{{ bio.data.intro | inlineMarkdown | safe }}</p>
        <p class="home-about-link scroll-reveal">
            <a href="{{ assetRoot }}about.html">More about me <span aria-hidden="true">→</span></a>
        </p>
    </section>
</main>
