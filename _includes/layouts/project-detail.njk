---
layout: layouts/base.njk
assetRoot: "../"
activePage: projects
permalink: projects/{{ slug }}.html
---
<main id="main" class="project-detail">
    <div class="project-detail-inner">
        <a href="../index.html#work" class="project-detail-back" data-smart-back data-asset-root="../">← Work</a>

        {% set pageOrg = organization or card_medium %}
        {% set pageTags = tags or card_tags %}
        {% set displayTitle = home_title or title %}
        <header class="project-detail-header">
            <p class="project-detail-kicker">{% if featured %}Selected work{% else %}Project{% endif %}</p>
            <h1 class="project-detail-title">{{ displayTitle }}</h1>
            {% if displayTitle != title %}
            <p class="project-detail-aka">{{ title }}</p>
            {% endif %}
            {% if lead %}
            <p class="project-detail-lead">{{ lead }}</p>
            {% endif %}

            <dl class="case-meta">
                {% if role %}
                <div class="case-meta-item">
                    <dt>Role</dt>
                    <dd>{{ role }}</dd>
                </div>
                {% endif %}
                {% if project_type %}
                <div class="case-meta-item">
                    <dt>Type</dt>
                    <dd>{{ project_type }}</dd>
                </div>
                {% endif %}
                {% if pageTags %}
                <div class="case-meta-item">
                    <dt>Tools</dt>
                    <dd>{{ pageTags }}</dd>
                </div>
                {% endif %}
                {% if year %}
                <div class="case-meta-item">
                    <dt>Year</dt>
                    <dd>{{ year }}</dd>
                </div>
                {% endif %}
                {% if team %}
                <div class="case-meta-item">
                    <dt>Team</dt>
                    <dd>{{ team }}</dd>
                </div>
                {% endif %}
                {% if not role and not project_type and not year and not team and pageOrg %}
                <div class="case-meta-item">
                    <dt>Context</dt>
                    <dd>{{ pageOrg }}</dd>
                </div>
                {% endif %}
            </dl>
        </header>

        {% if hero_image %}
        <figure class="project-detail-figure project-detail-figure--hero scroll-reveal">
            <img class="project-detail-hero" src="../{{ hero_image }}" alt="{{ hero_alt or title }}" width="1600" height="1000" fetchpriority="high" decoding="async">
        </figure>
        {% endif %}

        {% if project_award and project_award.title %}
        <section class="project-detail-award" aria-labelledby="project-award-heading">
            <h2 id="project-award-heading" class="project-detail-video-title">{{ project_award.title }}</h2>
            {% if project_award.text %}
            <p class="project-detail-award-text">{{ project_award.text }}</p>
            {% endif %}
            {% if project_award.image %}
            <figure class="project-detail-award-figure">
                <img
                    class="project-detail-award-image"
                    src="../{{ project_award.image }}"
                    alt="{{ project_award.image_alt or project_award.title }}">
            </figure>
            {% endif %}
        </section>
        {% endif %}

        {% if project_poster and project_poster.image %}
        <section class="project-detail-award" aria-labelledby="project-poster-heading">
            <h2 id="project-poster-heading" class="project-detail-video-title">{{ project_poster.title or "Project poster" }}</h2>
            {% if project_poster.text %}
            <p class="project-detail-award-text">{{ project_poster.text }}</p>
            {% endif %}
            <figure class="project-detail-award-figure">
                <img
                    class="project-detail-award-image"
                    src="../{{ project_poster.image }}"
                    alt="{{ project_poster.image_alt or project_poster.title or title }}">
            </figure>
        </section>
        {% endif %}

        {% if prototype_callout and prototype_callout.title %}
        <div class="project-prototype-callout" role="region" aria-labelledby="prototype-callout-heading">
            <p id="prototype-callout-heading" class="project-prototype-callout-title">{{ prototype_callout.title }}</p>
            {% if prototype_callout.text %}
            <p class="project-prototype-callout-text">
                {{ prototype_callout.text }}
                {% if prototype_callout.link_label and prototype_callout.link_url %}
                <a href="{{ prototype_callout.link_url }}" target="_blank" rel="noopener noreferrer">{{ prototype_callout.link_label }}</a>.
                {% endif %}
            </p>
            {% endif %}
            {% if prototype_callout.button_label and prototype_callout.button_url %}
            <a href="{{ prototype_callout.button_url }}" class="project-prototype-btn" target="_blank" rel="noopener noreferrer">{{ prototype_callout.button_label }}</a>
            {% endif %}
        </div>
        {% endif %}

        {% from "project-video.njk" import render as renderVideo %}
        {{ renderVideo(project_video, title) }}

        {% if project_pdf and project_pdf.file %}
        <section class="project-detail-pdf" aria-labelledby="project-pdf-heading">
            <h2 id="project-pdf-heading" class="project-detail-video-title">{{ project_pdf.title or "PDF" }}</h2>
            <div class="project-detail-pdf-actions">
                <a href="{{ project_pdf.file }}" target="_blank" rel="noopener noreferrer" class="cv-view">Open PDF in new tab</a>
            </div>
            <div class="project-detail-pdf-embed">
                <iframe src="{{ project_pdf.file }}" title="{{ project_pdf.title or title }}" loading="lazy"></iframe>
            </div>
        </section>
        {% endif %}

        <div class="project-detail-body">
            {% from "project-video.njk" import render as renderVideo %}
            {% if mid_video and mid_video.youtube_id and (content.indexOf("<p>MID_VIDEO_HERE</p>") != -1 or content.indexOf("MID_VIDEO_HERE") != -1) %}
            {% set midMarker = "<p>MID_VIDEO_HERE</p>" if content.indexOf("<p>MID_VIDEO_HERE</p>") != -1 else "MID_VIDEO_HERE" %}
            {% set contentParts = content.split(midMarker) %}
            {{ contentParts[0] | safe }}
            {{ renderVideo(mid_video, title) }}
            {{ contentParts[1] | safe }}
            {% else %}
            {{ content | safe }}
            {% endif %}

            {% if additional_images and additional_images.length %}
            {% if additional_images_heading %}
            <h2 class="project-detail-h2">{{ additional_images_heading }}</h2>
            {% endif %}
            {% if additional_images_intro %}
            <p>{{ additional_images_intro }}</p>
            {% endif %}
            {% if additional_images_pixel %}
            {% set wideImages = additional_images | whereWide(true) %}
            {% set gridImages = additional_images | whereWide(false) %}
            {% if wideImages.length %}
            <div class="project-asset-scroll" role="region" aria-label="{{ additional_images_heading or 'Wide assets' }} — scroll horizontally">
                <div class="project-asset-scroll-track">
                {% for item in wideImages %}
                <figure class="project-detail-figure project-detail-figure--inline project-detail-figure--pixel project-detail-figure--wide project-detail-figure--scroll">
                    <img class="project-detail-hero" src="../{{ item.image }}" alt="{{ item.caption or '' }}" loading="lazy" decoding="async">
                    {% if item.caption %}
                    <figcaption class="project-detail-caption">{{ item.caption }}</figcaption>
                    {% endif %}
                </figure>
                {% endfor %}
                </div>
            </div>
            {% endif %}
            {% if gridImages.length %}
            <div class="project-asset-gallery project-asset-gallery--pixel">
            {% for item in gridImages %}
            <figure class="project-detail-figure project-detail-figure--inline project-detail-figure--pixel{% if item.large %} project-detail-figure--large{% endif %}">
                <img class="project-detail-hero" src="../{{ item.image }}" alt="{{ item.caption or '' }}" loading="lazy" decoding="async">
                {% if item.caption %}
                <figcaption class="project-detail-caption">{{ item.caption }}</figcaption>
                {% endif %}
            </figure>
            {% endfor %}
            </div>
            {% endif %}
            {% else %}
            <div class="project-asset-gallery">
            {% for item in additional_images %}
            <figure class="project-detail-figure project-detail-figure--inline{% if item.wide %} project-detail-figure--wide{% endif %}{% if item.large %} project-detail-figure--large{% endif %}">
                <img class="project-detail-hero" src="../{{ item.image }}" alt="{{ item.caption or '' }}" loading="lazy" decoding="async">
                {% if item.caption %}
                <figcaption class="project-detail-caption">{{ item.caption }}</figcaption>
                {% endif %}
            </figure>
            {% endfor %}
            </div>
            {% endif %}
            {% endif %}

            {% if contributions and contributions.length %}
            {% set contributionsHeading = contributions_heading if contributions_heading else "My role" %}
            <h2 class="project-detail-h2">{{ contributionsHeading }}</h2>
            <ul class="project-detail-links">
                {% for item in contributions %}
                <li>{% if item.contribution %}{{ item.contribution }}{% elif item.item %}{{ item.item }}{% else %}{{ item }}{% endif %}</li>
                {% endfor %}
            </ul>
            {% endif %}

            {% from "project-video.njk" import render as renderVideo %}
            {{ renderVideo(contributions_video, title, "project-detail-video--after-contributions") }}

            {% if external_links and external_links.length %}
            <h2 class="project-detail-h2">Links</h2>
            <ul class="project-detail-links">
                {% for link in external_links %}
                <li><a href="{{ link.url }}" target="_blank" rel="noopener noreferrer">{{ link.label }}</a></li>
                {% endfor %}
            </ul>
            {% endif %}
        </div>
    </div>
</main>
